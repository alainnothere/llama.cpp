#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

#define MMQ
#define NEEDS_IQ1S_GRID_GPU
#define KVALUES_IQ4NL_I8
#define B_TYPE block_q8_1_x4
#define B_TYPEV4 block_q8_1_x4_packed128

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#if defined(DATA_A_Q2_0) || defined(DATA_A_QUANT_K)
#define K_PER_ITER 16
#elif defined(DATA_A_QUANT_LEGACY) || defined(DATA_A_MXFP4)
#define K_PER_ITER 8
#elif defined(DATA_A_IQ1_S) || defined(DATA_A_IQ1_M) || defined(DATA_A_IQ4_XS)
#define K_PER_ITER 32
#else
#error unimplemented
#endif

uint a_offset, b_offset, d_offset;

// For these types the A block is unpacked once per row (mmvq_load_a) and dotted against every
// cached B column (mmvq_dot_cached). The old order re-unpacked A for every column, which made
// n=8 cost 2.4x n=1 on RDNA3 although the weights stream once either way. The IQ types keep the
// old single-column cache until they get the same treatment.
#if defined(DATA_A_QUANT_LEGACY) || defined(DATA_A_MXFP4) || defined(DATA_A_Q2_0) || defined(DATA_A_QUANT_K)
#define MMVQ_A_CACHED
#endif

#ifdef MMVQ_A_CACHED
int32_t cache_b_qs[NUM_COLS][K_PER_ITER / 4];
vec2 cache_b_ds[NUM_COLS];
#define B_QS(j) cache_b_qs[j]
#define B_DS(j) cache_b_ds[j]
#else
int32_t cache_b_qs[K_PER_ITER / 4];
vec2 cache_b_ds;
#define B_QS(j) cache_b_qs
#define B_DS(j) cache_b_ds
#endif

#include "mul_mat_vecq_funcs.glsl"

void load_b(const uint j, const uint col, const uint b_qs_idx) {
    const uint b_block_idx = (j*p.batch_stride_b + col) / QUANT_K_Q8_1 + b_offset;
    const uint b_block_idx_outer = b_block_idx / 4;
    const uint b_block_idx_inner = b_block_idx % 4;
    B_DS(j) = vec2(data_b[b_block_idx_outer].ds[b_block_idx_inner]);

#if QUANT_R == 2
    // Assumes K_PER_ITER == 8
    B_QS(j)[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx];
    B_QS(j)[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx + 4];
#else
#if K_PER_ITER == 8
    B_QS(j)[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2];
    B_QS(j)[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2 + 1];
#elif K_PER_ITER == 16
    // one 128-bit load instead of four 32-bit ones (block_q8_1_x4 is 16-byte aligned)
    {
        const ivec4 v = data_b_v4[b_block_idx_outer].qs[b_block_idx_inner * 2 + b_qs_idx];
        B_QS(j)[0] = v.x;
        B_QS(j)[1] = v.y;
        B_QS(j)[2] = v.z;
        B_QS(j)[3] = v.w;
    }
#elif K_PER_ITER == 32
    {
        const ivec4 v0 = data_b_v4[b_block_idx_outer].qs[b_block_idx_inner * 2    ];
        const ivec4 v1 = data_b_v4[b_block_idx_outer].qs[b_block_idx_inner * 2 + 1];
        B_QS(j)[0] = v0.x;
        B_QS(j)[1] = v0.y;
        B_QS(j)[2] = v0.z;
        B_QS(j)[3] = v0.w;
        B_QS(j)[4] = v1.x;
        B_QS(j)[5] = v1.y;
        B_QS(j)[6] = v1.z;
        B_QS(j)[7] = v1.w;
    }
#else
#error unimplemented
#endif
#endif
}

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
#ifdef MMVQ_A_CACHED
    // all B columns first, then each A block exactly once
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        load_b(j, col, b_qs_idx);
    }

    uint ibi = first_row*p.ncols;
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
        ibi += p.ncols;

        const mmvq_a_t a = mmvq_load_a(a_block_idx, b_qs_idx);
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            temp[j][n] += mmvq_dot_cached(a, j);
        }
    }
#else
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        load_b(j, col, b_qs_idx);

        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
            ibi += p.ncols;

            temp[j][n] += mmvq_dot_product(a_block_idx, b_qs_idx);
        }
    }
#endif
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    get_offsets(a_offset, b_offset, d_offset);
    a_offset *= QUANT_K / QUANT_K_Q8_1;
    b_offset /= QUANT_K_Q8_1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
        }
    }

    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
        num_iters++;
    }

    const uint b_qs_idx = tid % (32 / K_PER_ITER);
    uint col = tid * K_PER_ITER;
    while (num_iters >= 4) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            iter(temp, first_row, num_rows, col, b_qs_idx);
            col += col_stride;
        }

        num_iters -= 4;
    }

    if (num_iters >= 2) {
        // Manually partially unroll the loop
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        num_iters -= 2;
    }

    if (num_iters > 0) {
        iter(temp, first_row, num_rows, col, b_qs_idx);
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
