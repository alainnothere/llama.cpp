#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#if defined(BFLOAT16)
#extension GL_EXT_bfloat16 : enable
#endif

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable

#include "types.glsl"
#include "flash_attn_base.glsl"
#if !defined(BFLOAT16)
#define FA_WANT_DEQUANT8_Q8_0   // dequantize8_q8_0, the PV_REG quant loader (GGML_VK_FA_PV_REG_QUANT C2)
#include "flash_attn_dequant.glsl"
#endif

// These need to be supported N,M values for a MatBc x MatBr x 16 coopmatmuladd
const uint32_t MatBr = 16;
const uint32_t MatBc = 16;

const uint32_t rows_per_thread = Br / row_split;
const uint32_t cols_per_iter = gl_WorkGroupSize.x / row_split;
const uint32_t cols_per_thread = Bc / cols_per_iter;

// PV_REG (GGML_VK_FA_PV_REG=1|2, Flags bits 1024|2048), 2026-10-20. Persistent P.V accumulators:
// subgroup s owns the contiguous head-dim slice [s*PV_SLICE, (s+1)*PV_SLICE) across all Bc KV columns and keeps
// it in PV_TILES named 16x16 coopmat accumulators for the whole KV loop. P is loaded once per 16-column KV
// chunk, the per-row rescale is one component-wise multiply by a 16x16 coopmat loaded from emsh, and O goes
// through shared memory once per workgroup (into the dead Qf) to be rebuilt into Of for the unchanged
// epilogue / split-k store.
// Accumulator precision: mode 1 (PV_F32) = ACC_TYPE (f32 under GGML_PREC_F32, i.e. production; == f16 in the
// f16acc pipelines), accumulators PvA0..3, f32 rescale. Mode 2 (Flags 2048) = O_TYPE (f16) accumulators PvH0..3,
// f16 rescale: the perf probe. The old path is f16 throughout (PVMat O_TYPE per slice, Of O_TYPE across blocks,
// flash_attn_base.glsl O_TYPE = FLOAT_TYPE), so mode 1 is the first cm1 variant that sums P.V in f32 across KV;
// both modes round O to f16 once, when it is rebuilt into Of (Of stays O_TYPE so the epilogue is unchanged).
// Steps (fa-cm1-pv-partition-design.md section 3): A = persistent accumulators (above), B = S computed as
// Q * K^T and stored row-major so P is row-major and its A load is per-lane contiguous, C = V staged per
// subgroup transposed through kvsh so its B load is per-lane contiguous. Modes: 1 = A+B (ACC_TYPE acc),
// 2 = A+B (f16 acc), 3 = A+B+C (ACC_TYPE acc). Flags 1024 = PV_REG, +2048 = f16 acc, +4096 = step C.
// Measured 2026-10-20, 7900 XTX, test-backend-ops 27B case (hs 256, 4 kv heads x 6, kv 32768, f16), us at
// nb 1/6/12, 5320/5320 FA tests in every mode at wave32 and wave64 (named loop-crossing coopmats and the
// f16 x f16 -> f32 accumulate both work on RADV 25.2.6):
//   wave32  old 187.4/322.5/545.1, mode 1 185.1/283.6/483.6, mode 2 186.0/278.2/476.5, mode 3 181.3/234.7/457.0
//   wave64  old 194.0/354.9/661.8, mode 1 189.5/280.8/499.5, mode 3 181.8/262.2/486.2
//   unmasked (ABLATE 32, = production decode with mask_opt): old 181.3/281.6/511.1, mode 3 181.4/191.4/360.5
//   loop skeleton (ABLATE 480): old 25.6/46.8/88.1, mode 3 21.1/30.4/48.6
//   step A alone (before B/C existed): mode 1 185.8/310.3/495.7; its ABLATE 512 at nb12 was 367 = the bound
//   for fixing both operand layouts. Mode 3 + 512 = 457.3 (no-op). Mode 3 is ~95 us over that bound at nb12,
//   ~25 at nb6: the transposed-V staging is not free (open question, design brief section 9).
// RADV ISA of this pipeline, static counts in the KV-loop body + epilogue (wave32, nb 6):
//   old    148 buffer_load_d16_b16 + 136 d16_hi_b16 (V), 128 + 128 ds_load_u16_d16(_hi) (P), 48 buffer_load_b128,
//          36 ds_load_b128, 14 s_barrier
//   mode 1 128 + 128 d16 (V), 0 ds_load_u16, 40 ds_load_b128 (Q 32 + P 8), 48 b128 global, 9 s_barrier
//   mode 3 0 d16 loads; 32 buffer_load_b64 + 32 ds_store_b64 + 32 ds_load_b128 for V (72 ds_load_b128 total),
//          48 b128 global, 9 s_barrier. Matches the predicted counts exactly.
//   P stores stay 8 ds_store_b16 per block (the adjacent f16 pair is not merged into b32 by ACO).
// Workgroup barriers per block: old 11, PV_REG 3 (+3 when the mask is loaded in each).
// LDS (27B shape, f32acc): old 25,968 + 28 B unreferenced PV_REG placeholders = 25,996 B; modes 1/2 17,048 B
// (Qf 8448, Psh2 2304, sfsh2 5120, emsh 1024, rest 152); mode 3 29,328 B (+ transposed V 12,288). VGPR per lane
// at wave32: O 32 (4 accumulators x 8, f32 or f16 alike on gfx11) vs Of 16 old, EM 8 transient; mode 3 adds 16
// for the 4 staged f16vec4 + 4 packed outputs. Occupancy is grid-bound (~2 WGs per CU), so none of this moves it.
// Mode 1 epilogue converts f32 -> f16 once per accumulator.
// Old path kept for everything else: quant K/V (except q8_0 under GGML_VK_FA_PV_REG_QUANT, see PV_REG_TYPES), unaligned (Clamp), sparse, shmem staging, BF16 (O_TYPE f32),
// HSV > 256 (8 accumulators), Br > 16, HSV not a multiple of 64 (PV_SLICE not 16-aligned), HSV > HSK (Qf too small for O).
// RADV crashed at pipeline creation on a coopmat ARRAY live across the slice loop (2026-10-09), so the
// accumulators are named variables and every coopmat temporary is scoped to one loop body. The unused set
// (PvA* or PvH*) and unused tiles (PV_TILES < 4) fold away after specialization.
// Design: contextFiles/aiInstructionsAndResponses/fa-cm1-pv-partition-design.md section 3, step A.
const uint32_t PV_SLICE = HSV_pad / row_split;
const uint32_t PV_TILES = PV_SLICE / 16;
#if defined(BFLOAT16)
const bool PV_REG = false;
#else
// Split into small terms: one long && chain of spec constants made glslang (shaderc 2025.2) emit part of it
// as function-scope OpPhi referenced from an OpSpecConstantOp, which spirv-val rejects.
const bool PV_REG_SHAPE = Br == 16 && HSV == HSV_pad && HSK == HSK_pad && HSV_pad <= 256 && HSV_pad <= HSK_pad;
const bool PV_REG_SLICE = (HSV_pad % (16 * row_split)) == 0;
const bool PV_REG_MEM   = SHMEM_STAGING == 0 && Clamp == 0 && !USE_SPARSE;
// GGML_VK_FA_PV_REG_QUANT (Flags 32768, 2026-10-24, candidate C1 of q8-kv-faster-than-f16.md.response): q8_0 K
// and/or V enter PV_REG, mode 3 only, because both dequant stagings live in the subgroup's own step-C region of
// kvsh (vt_base below, PV_SLICE * VT4 f16vec4 = 3,072 B at hs 256), which modes 1/2 do not declare.
//   K: per 16-d chunk of the Q.K loop the subgroup dequantizes its own 16 kv rows x 16 d into that region
//      ([kv][d], row stride VT4) and loads KB ColumnMajor from it; subgroup barriers only. The region is free in
//      the Q.K phase: step C of the previous block finished before the end-of-block barrier, step C of this block
//      starts after the S barrier and the softmax barrier. Shared memory growth: zero.
//   V: step C dequantizes on the rebuilt quant coordinate (row * v_stride * BLOCK_SIZE_V + d, as the old path
//      does; v_base is in f16vec4 units and meaningless for blocks) instead of the four f16vec4 loads.
//   Both sides use dequantize8_q8_0 (C2, flash_attn_dequant.glsl) since 2026-10-24; C1 used dequantize4.
// Only Q8_0: USE_DECODE_K/V (FaType != F16) also catch F32/BF16 and the 4/5-bit types, which keep the old path.
// Mixed q8_0/f16 costs nothing extra (each side is chosen independently), so it is allowed.
// Measured 2026-10-24 (XTX, 27B shape, kv 229k, numbers at the GGML_VK_FA_PV_REG_QUANT knob in ggml-vulkan.cpp):
// 0.56-0.60x the old q8 path everywhere, 0.67x f16 at 1-2 tokens, 1.68x f16 at 6: the dequant is paid once per
// 16-row tile (~1.45 us per 1k KV per side per tile), where f16's extra tiles are L2 hits.
// Written with ! and two-operand && only: "a || (b && c)" on spec constants made glslang (shaderc 2025.2) emit a
// short-circuit OpPhi for a global OpSpecConstantOp, spirv-val "ID PV_REG_K_OK has not been defined", and RADV
// 25.2.6 segfaulted creating every cm1 FA pipeline, f16 included (2026-10-24, first build of this change).
const bool PV_REG_K_F16 = FaTypeK == GGML_TYPE_F16;
const bool PV_REG_V_F16 = FaTypeV == GGML_TYPE_F16;
const bool PV_REG_K_IS8 = FaTypeK == GGML_TYPE_Q8_0;
const bool PV_REG_V_IS8 = FaTypeV == GGML_TYPE_Q8_0;
const bool PV_REG_K_Q8  = PV_REG_Q8_REQ && PV_REG_K_IS8;
const bool PV_REG_V_Q8  = PV_REG_Q8_REQ && PV_REG_V_IS8;
const bool PV_REG_K_BAD = !PV_REG_K_F16 && !PV_REG_K_Q8;
const bool PV_REG_V_BAD = !PV_REG_V_F16 && !PV_REG_V_Q8;
const bool PV_REG_KV_F16 = PV_REG_K_F16 && PV_REG_V_F16;          // q8 needs mode 3 (its staging is in the step-C region)
const bool PV_REG_Q8_NOC = !PV_REG_KV_F16 && !PV_REG_C_REQ;
const bool PV_REG_TYPES_BAD = !(!PV_REG_K_BAD && !PV_REG_V_BAD);
const bool PV_REG_TYPES = !PV_REG_TYPES_BAD && !PV_REG_Q8_NOC;
const bool PV_REG = PV_REG_REQ && PV_REG_SHAPE && PV_REG_SLICE && PV_REG_MEM && PV_REG_TYPES;
#endif
const bool PV_F32 = PV_REG && !PV_REG_F16_REQ;
// Step C (mode 3): each subgroup stages its 16 kv x PV_SLICE V slice per KV chunk into its own region of
// kvsh, transposed to [d][kv], so the V B-operand load is ColumnMajor = per-lane contiguous (2 x b128).
const bool PV_C = PV_REG && PV_REG_C_REQ;
// TILE_LOOP (GGML_VK_FA_TILE_LOOP, Flags bits 16-17 = TL - 1, 2026-10-24, C5 for q8_0 KV): one workgroup walks its KV
// range once for TL consecutive 16-row tiles of the GQA dense fold, and every K chunk / V slice it dequantizes into
// kvsh is consumed by all TL tiles (TL Q.K MMAs per K chunk, TL P.V MMAs per V B-operand), instead of TL workgroups
// each dequantizing the same KV block. Every MMA stays 16 rows (the f16 lesson: Br 32/48 lost, LDS triples and the
// 2-WG/CU occupancy halves; GGML_VK_FA_FOLD_MAX_BR comment in ggml_vk_flash_attn). Per-tile state: Q, S, P and the
// eM rows live in TL copies of Qf / sfsh2 / Psh2 / emsh (contiguous: tile t at row t * Br), the P.V accumulators
// are TL x PV_TILES named coopmats (PvA* tile 0, PvB* tile 1, PvC* tile 2; RADV crashes on loop-crossing coopmat
// arrays), M / L / eM are TL x rows_per_thread register arrays and the epilogue runs once per tile.
// PV_C (mode 3) + GQA_DENSE only (rows are numbered continuously from gqa_row0, so tile t is rows t * Br ..);
// any other variant sees TL = 1 and the arrays above are their old size. The host sets the bits only for
// q8_0 K/V under GGML_VK_FA_PV_REG_QUANT (f16 has nothing to share: its extra tiles hit L2, see the fold comment).
// Measured 2026-10-24 (XTX, 27B shape, full tables + dead probes at GGML_VK_FA_TILE_LOOP in ggml-vulkan.cpp): q8 at 229k
// 4 tokens 1249 -> 1004 us (TL 2, 0.92x f16), 6-8 tokens 1838 -> 1612 (TL 3, 1.34x f16), 16 tokens 3594 -> 2827 (TL 2).
// Per extra tile at 131k: Q.K-only 151-163 -> 85-118 us, P.V-only ~200 -> 163-173 us; the rest is per-tile MMA/LDS work.
const uint TL_REQ = 1u + ((Flags >> 16) & 3u);
const bool TL_GQA = (Flags & 16384) != 0;
#if defined(ACC_TYPE_MAX) || defined(BFLOAT16)
const bool TL_ACC = false;   // f16acc / bf16: S is not aliased into kvsh (below), the host never asks there
#else
const bool TL_ACC = true;
#endif
const bool TL_OK0 = PV_C && TL_GQA;
const bool TL_OK  = TL_OK0 && TL_ACC;
const uint TL     = TL_OK ? TL_REQ : 1u;
// Step B layouts (all PV_REG modes). S is computed as S = Q * K^T (not S^T) and stored row-major, so P is
// row-major too and the P.V A load is RowMajor = per-lane contiguous (2 x b128 instead of 16 x u16).
// Strides chosen for the gfx11 LDS (64 x 4 B banks; also clean for the 32-bank half-wave view):
//   psh2_stride  = Bc/2 + 4 f16vec2 = 72 halves = 144 B (16 B aligned rows for b128). P A load: lanes 0..15
//                  start at dword 36m -> banks {0,36,8,44,...,28} + 0..3 = all 64 banks once: conflict-free.
//                  P store (wave32): lane l writes f16vec2 at dword row*36 + l: 32 consecutive dwords.
//   sfsh2_stride = Bc/2 + 8 vec2 = 80 floats. S accumulator store: lanes 0..15 write row 2i (16 dwords),
//                  lanes 16..31 row 2i+1 at +80 dwords = +16 banks: disjoint, conflict-free. With the
//                  unpadded 64-float row the two halves land on the same 16 banks (2-way).
//   VT4          = 6 f16vec4 = 24 halves = 48 B per transposed-V row (16 kv + 8 pad). V B load: lane n starts
//                  at dword 12n -> 16 distinct 4-bank groups: conflict-free. Staging store (b64): per half-wave
//                  4 d-groups at 48 dwords apart + 8 dwords of kv quads: conflict-free.
const uint psh2_stride  = Bc / 2 + 4;
const uint sfsh2_stride = Bc / 2 + 8;
const uint VT4 = 6;
// TILE_LOOP shared-memory layout (iteration 2, 2026-10-24). Iteration 1 kept sfsh2 x TL and the full 12 KB transposed-V
// kvsh: 46.3 KB at TL 2, 63 KB at TL 3, 1 WG per CU, and that occupancy loss ate the sharing (numbers at the host
// knob in ggml-vulkan.cpp). At TL > 1 each subgroup now owns one kvsh region of PV_REGION f16vec4 (8 B) that holds,
// in time order within a KV block: its 16 x 16 K chunk (Q.K), its 16 S columns of all TL tiles in f32 (S_ALIAS,
// TL * Br rows x 8 elements, written by coopMatStore of the f32 accumulator into the f16vec4 array, read back with
// bit casts), then its transposed V slice in PV_VPH phases (TL 2: two 32-d halves per 16-kv chunk, so the region is
// max(2 x 128 S, 32 x VT4 V) = 256). sfsh2 shrinks to one element. Every hand-over inside a region is subgroup
// private (subgroup barriers), the S hand-over to the softmax already had its workgroup barrier, so no workgroup
// barrier is added. PV_REGION is padded to 8 mod 16 elements so the softmax S reads of the four regions land on
// disjoint 64-bank windows (16 dwords per 8-lane group, regions 528 dwords = 16 mod 64 apart).
// TL 2 LDS: Qf 16,896 + Psh2 4,616 + kvsh 4 x 264 x 8 = 8,448 + emsh 2,048 + small ~ 32.2 KB: 2 WGs per CU.
const bool S_ALIAS = TL > 1;
const uint PV_VPH  = (TL == 2) ? 2u : 1u;           // V staging phases per 16-kv chunk
const uint PV_TPH  = PV_TILES / PV_VPH;             // 16-d V tiles per phase
const uint PV_SROWS = TL * Br * (MatBc / 2);        // S elements per region (8 B = two f32 per element)
const uint PV_VROWS = (PV_SLICE / PV_VPH) * VT4;    // transposed-V elements per phase
const uint PV_RRAW  = PV_SROWS > PV_VROWS ? PV_SROWS : PV_VROWS;
const uint PV_REGION = S_ALIAS ? (((PV_RRAW + 7) / 16) * 16 + 8) : (PV_SLICE * VT4);
#define PV_ACC(T) coopmat<T, gl_ScopeSubgroup, MatBr, MatBc, gl_MatrixUseAccumulator>


layout (binding = 0) readonly buffer Q {float data_q[];};
layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
layout (binding = 1) readonly buffer K {FLOAT_TYPE data_k[];};
layout (binding = 1) readonly buffer KV4 {FLOAT_TYPEV4 data_kv4[];};
layout (binding = 2) readonly buffer V {FLOAT_TYPE data_v[];};
layout (binding = 2) readonly buffer VV4 {FLOAT_TYPEV4 data_vv4[];};
layout (binding = 3) readonly buffer M {float16_t data_m[];};

shared float tmpsh[row_split];

const uint32_t qstride = HSK_pad / 4 + 2;
shared FLOAT_TYPEV4 Qf[TL * Br * qstride];   // TILE_LOOP: TL tiles, tile t at row t * Br

const uint psh_stride = Br / 4 + 2;
shared FLOAT_TYPEV4 Psh[PV_REG ? 1 : (Bc * psh_stride)];
// PV_REG: P as [Br rows][Bc kv] f16, row stride psh2_stride f16vec2
shared FLOAT_TYPEV2 Psh2[PV_REG ? (TL * Br * psh2_stride) : 1];

// Avoid padding for hsk==256 to make it fit in 48KB shmem.
const uint32_t sfshstride = (HSK <= 128) ? (Br / 4 + 2) : Br / 4;
shared ACC_TYPEV4 sfsh[PV_REG ? 1 : (Bc * sfshstride)];
// PV_REG: S as [Br rows][Bc kv] ACC_TYPE, row stride sfsh2_stride vec2
shared ACC_TYPEV2 sfsh2[(PV_REG && !S_ALIAS) ? (Br * sfsh2_stride) : 1];


const uint32_t D_pad = HSK_pad > HSV_pad ? HSK_pad : HSV_pad;
const uint32_t kvsh_stride = (SHMEM_STAGING != 0 ? D_pad : MatBr) / 4 + 2;
const uint v_cols = MatBc / 4 * row_split; // total cols, 4 vec4s per MatBc * number of subgroups
const uint vsh_stride = v_cols;
// PV_REG never stages K or V the old way (aligned f16 only), so kvsh shrinks to one element there, except in
// mode 3 (PV_C), where it holds the four per-subgroup transposed V slices: HSV_pad d rows x VT4 (12,288 B at hs 256).
shared FLOAT_TYPEV4 kvsh[PV_REG ? (PV_C ? (row_split * PV_REGION) : 1) : ((kvsh_stride >= vsh_stride) ? (Bc * kvsh_stride) : (Bc * vsh_stride))];

// S (PV_REG step B) element-pair address and access. TL 1: row-major sfsh2 as before. S_ALIAS (TILE_LOOP): pair
// p of global row r (r < TL * Br) lives in the region of subgroup p / 8 (the subgroup that computed those 16 kv
// columns), at tile (r / Br) * Br * 8 + (r % Br) * 8 + p % 8, as two f32 bit-cast into one f16vec4.
uint s_idx(const in uint r, const in uint pair) {
    if (S_ALIAS) {
        return (pair / (MatBc / 2)) * PV_REGION + r * (MatBc / 2) + pair % (MatBc / 2);
    }
    return r * sfsh2_stride + pair;
}
#if !defined(BFLOAT16) && !defined(ACC_TYPE_MAX)
ACC_TYPEV2 s_ld(const in uint a) {
    if (S_ALIAS) {
        const f16vec4 v = kvsh[a];
        return ACC_TYPEV2(uintBitsToFloat(packFloat2x16(v.xy)), uintBitsToFloat(packFloat2x16(v.zw)));
    }
    return sfsh2[a];
}
void s_st(const in uint a, const in ACC_TYPEV2 x) {
    if (S_ALIAS) {
        kvsh[a] = f16vec4(unpackFloat2x16(floatBitsToUint(x.x)), unpackFloat2x16(floatBitsToUint(x.y)));
    } else {
        sfsh2[a] = x;
    }
}
#else
ACC_TYPEV2 s_ld(const in uint a) { return sfsh2[a]; }
void s_st(const in uint a, const in ACC_TYPEV2 x) { sfsh2[a] = x; }
#endif

const uint32_t osh_stride = row_split * MatBr / 4;
shared O_TYPEV4 pvsh[PV_REG ? 1 : (Br * osh_stride)];
// PV_REG emsh: 16 rows x 16 columns of the per-row rescale factor eM (each row replicated), ACC_TYPE so mode 1
// rescales in f32; loaded as an accumulator coopmat. Written with the Psh2 writes (eMf), read by the EM load
// right after the barrier that follows the SHMEM_STAGING V block, which covers it.
shared ACC_TYPEV4 emsh[PV_REG ? (TL * 16 * 16 / 4) : 1];

// number of 16-row Q blocks per tile
const uint32_t RowBlocks = Br / MatBr;

// GQA_DENSE (GGML_VK_FA_GQA_DENSE, Flags 16384, 2026-10-22): the fold numbers the (token, head) rows of one KV
// head continuously, row g = token * gqa_ratio + head, and tile t covers rows [t * Br, t * Br + Br), so a 16-row
// tile is full even when gqa_ratio does not divide 16 (a token's heads may straddle two tiles). The token-group fold
// packs floor(16 / gqa_ratio) whole tokens per tile: at gqa_ratio 6 that is 12 of 16 rows, and n tokens cost
// ceil(n / 2) tiles = KV passes, where the dense fold needs ceil(6 n / 16): 7-8 tokens 4 -> 3, 9-10 5 -> 4,
// 11-12 6 -> 5 (12 is unfolded otherwise: 24 heads x 1 tile = 6 passes per KV head). At 6+ rows each pass is paid
// in full (~5 us per KV block per workgroup, not per K/V byte; measurements at the fold in ggml_vk_flash_attn), so
// fewer, fuller tiles is the lever. gqa_iq1 is 0 in this mode (rows carry absolute tokens), so m_offset starts at
// mask row 0 and gqa_row_mrow() indexes the mask by the absolute token.
const bool GQA_DENSE = (Flags & 16384) != 0;
uint32_t gqa_row0 = 0;   // GQA_DENSE: first global (token, head) row of this tile
// GQA row -> (token, head) helpers. Valid only when p.gqa_ratio > 1.
uint32_t gqa_row_token(const in uint32_t r) { return GQA_DENSE ? (gqa_row0 + r) / p.gqa_ratio : gqa_iq1 + r / p.gqa_ratio; }
uint32_t gqa_row_head(const in uint32_t r)  { return iq2 + (GQA_DENSE ? gqa_row0 + r : r) % p.gqa_ratio; }
// mask row of tile row r relative to m_offset (= gqa_iq1 * KV)
uint32_t gqa_row_mrow(const in uint32_t r)  { return gqa_row_token(r) - gqa_iq1; }
// row index whose "% gqa_ratio" is the head, for the shared perElemOp* helpers (flash_attn_base.glsl)
uint32_t gqa_row_hidx(const in uint32_t r)  { return GQA_DENSE ? gqa_row0 + r : r; }
// p.ne2 is the token count (O has coords 1,2 swapped relative to Q)
// TILE_LOOP: r spans the TL tiles (r < TL * Br; N == Br in GQA_DENSE)
bool gqa_row_valid(const in uint32_t r)     { return r < N * TL && gqa_row_token(r) < p.ne2; }

shared ACC_TYPE slope[TL * Br];

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    if (fa_type_needs_shmem(FaTypeK) || fa_type_needs_shmem(FaTypeV)) {
        init_iq_shmem(gl_WorkGroupSize);
    }
#endif

    init_indices();
    if (GQA_DENSE) {
        // the host dispatches ceil(n * gqa_ratio / Br) tiles per KV head (x split_k), see ggml_vk_flash_attn
        gqa_row0 = (p.k_num > 1 ? gl_WorkGroupID.x / p.k_num : gl_WorkGroupID.x) * Br * TL;   // TILE_LOOP: TL tiles per WG
        gqa_iq1 = 0;
    }

    const uint32_t tid = gl_LocalInvocationIndex;

    const uint32_t threads_per_rowgroup = gl_WorkGroupSize.x / row_split;
    const uint32_t d_per_thread = (HSV/4 + threads_per_rowgroup - 1) / threads_per_rowgroup;
    const uint32_t row_tid = gl_LocalInvocationIndex / threads_per_rowgroup;
    const uint32_t col_tid = gl_LocalInvocationIndex % threads_per_rowgroup;

#define tile_row(r) (row_tid * rows_per_thread + (r))

    // Zero-initialize shared memory for Q/K when HSK is not a multiple of 16 (HSK_pad > HSK).
    if ((HSK % 16) != 0) {
        [[unroll]] for (uint i = 0; i < TL * Br * qstride; i += gl_WorkGroupSize.x) {
            if (i + tid < TL * Br * qstride) {
                Qf[i + tid] = FLOAT_TYPEV4(0);
            }
        }
        barrier();
    }

    uint32_t q_offset = gqa_iq1*p.nb01 + (iq2*p.nb02+iq3*p.nb03) / 4;

    [[unroll]] for (uint32_t idx = 0; idx < TL * Br * HSK / 4; idx += gl_WorkGroupSize.x) {
        uint32_t d = (idx + tid) % (HSK / 4);
        uint32_t r = (idx + tid) / (HSK / 4);
        if (r < TL * Br && d < HSK / 4) {
            if (p.gqa_ratio > 1) {
                if (gqa_row_valid(r)) {
                    // nb01 is in elements, nb02/nb03 in bytes (see init_indices)
                    const uint32_t qo = gqa_row_token(r) * p.nb01 + (gqa_row_head(r) * p.nb02 + iq3 * p.nb03) / 4;
                    Qf[r * qstride + d] = FLOAT_TYPEV4(data_qv4[qo / 4 + d] * p.scale);
                } else {
                    // padding row of the last token group: keep shared memory defined
                    Qf[r * qstride + d] = FLOAT_TYPEV4(0);
                }
            } else if (i * Br + r < N) {
                Qf[r * qstride + d] = FLOAT_TYPEV4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d] * p.scale);
            }
        }
    }
    barrier();

    O_TYPEV4 Of[rows_per_thread][d_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        [[unroll]] for (uint32_t d = 0; d < d_per_thread; ++d) {
            Of[r][d] = O_TYPEV4(0.0);
        }
    }

    // TILE_LOOP: tile t's rows at [t * rows_per_thread, (t + 1) * rows_per_thread)
    float Lf[rows_per_thread * TL], Mf[rows_per_thread * TL];

    // Use -FLT_MAX/2 rather than -inf to reduce the possibility of NaNs, e.g. when computing Mold-M.
    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread * TL; ++r) {
        Lf[r] = 0;
        Mf[r] = NEG_FLT_MAX_OVER_2;
    }

    // ALiBi
    if (p.max_bias > 0.0f) {
        if (tid < TL * Br) {
            uint r = tid;
            slope[r] = perElemOpComputeSlope(gqa_row_hidx(r), col_tid, ACC_TYPE(0), iq2);
        }
    } else {
        if (tid < TL * Br) {
            uint r = tid;
            slope[r] = ACC_TYPE(1.0);
        }
    }

    const uint32_t mo_stride = CEIL_DIV(KV, 16 * Bc);
    // mo_offset will point to the tile starting at row i*Br and col 0
    uint32_t mo_offset = mo_stride * i;

    // FaBlockBytesK/V == 2 for f16 (sizeof f16) and == 16 for f32 (vec4) and == ggml block size for quants.
    uint32_t k_offset = (ik2*p.nb12 + ik3*p.nb13) / FaBlockBytesK;
    uint32_t v_offset = (iv2*p.nb22 + iv3*p.nb23) / FaBlockBytesV;
    uint32_t m_offset = gqa_iq1*KV;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
        mo_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * CEIL_DIV(p.nem1, Br) * mo_stride;
    }

    uint32_t mask_opt = 0;
    uint32_t mask_opt_idx = ~0;
    uint32_t mask_opt_bits = 0;
    f16vec4 mask_cache[Bc * Br * TL / 4 / WorkGroupSize];

    // PV_REG accumulators: named, not an array (RADV pipeline-creation crash on loop-crossing coopmat arrays).
    // PvA* = mode 1 (ACC_TYPE), PvH* = mode 2 (O_TYPE); the unused set and tiles >= PV_TILES fold away.
    PV_ACC(ACC_TYPE) PvA0 = PV_ACC(ACC_TYPE)(0), PvA1 = PV_ACC(ACC_TYPE)(0), PvA2 = PV_ACC(ACC_TYPE)(0), PvA3 = PV_ACC(ACC_TYPE)(0);
    PV_ACC(O_TYPE)   PvH0 = PV_ACC(O_TYPE)(0),   PvH1 = PV_ACC(O_TYPE)(0),   PvH2 = PV_ACC(O_TYPE)(0),   PvH3 = PV_ACC(O_TYPE)(0);
    // TILE_LOOP (mode 3 = PV_F32 only): PvB* = tile 1, PvC* = tile 2; fold away at TL 1 / 2
    PV_ACC(ACC_TYPE) PvB0 = PV_ACC(ACC_TYPE)(0), PvB1 = PV_ACC(ACC_TYPE)(0), PvB2 = PV_ACC(ACC_TYPE)(0), PvB3 = PV_ACC(ACC_TYPE)(0);
    PV_ACC(ACC_TYPE) PvC0 = PV_ACC(ACC_TYPE)(0), PvC1 = PV_ACC(ACC_TYPE)(0), PvC2 = PV_ACC(ACC_TYPE)(0), PvC3 = PV_ACC(ACC_TYPE)(0);

    [[dont_unroll]]
    for (uint32_t j = start_j; j < end_j; ++j) {

        [[unroll]] for (uint32_t idx = 0; idx < mask_cache.length(); ++idx) {
            mask_cache[idx] = f16vec4(0);
        }

        if (MASK_ENABLE && !ABL_MASK) {
            if (USE_MASK_OPT && mask_opt_idx != j / 16) {
                mask_opt_idx = j / 16;
                mask_opt = data_mask_opt[mo_offset + mask_opt_idx];
            }
            mask_opt_bits = (mask_opt >> ((j % 16) * 2)) & 0x3;
            if (mask_opt_bits == MASK_OPT_ALL_NEG_INF) {
                // skip this block
                continue;
            }
            // Only load if the block is not all zeros
            if (mask_opt_bits != MASK_OPT_ALL_ZERO) {
                bool nem1_bounds_check = !(p.gqa_ratio > 1) && (p.nem1 % Br) != 0;

                float max_mask = NEG_FLT_MAX_OVER_2;
                if (PV_REG) {
                    // step B: mask_cache holds 4 consecutive kv columns of one row (matches row-major sfsh2).
                    // PV_REG excludes sparse and Clamp, so every kv column is active.
                    // TILE_LOOP: rows of all TL tiles; the block is skipped below only if every tile's rows are -inf
                    [[unroll]] for (uint32_t idx = 0; idx < Bc * Br * TL / 4; idx += gl_WorkGroupSize.x) {
                        const uint32_t row = (idx + tid) / (Bc / 4);
                        const uint32_t cq  = (idx + tid) % (Bc / 4);
                        f16vec4 m = f16vec4(0.0);
                        const bool valid = (p.gqa_ratio > 1) ? (row < N * TL && gqa_row_token(row) < p.nem1)
                                                             : (i * Br + row < p.nem1);
                        if (valid) {
                            const uint32_t mb = m_offset + ((p.gqa_ratio > 1) ? gqa_row_mrow(row) * KV : (i * Br + row) * m_stride) + j * Bc + cq * 4;
                            m = f16vec4(data_m[mb], data_m[mb + 1], data_m[mb + 2], data_m[mb + 3]);
                            max_mask = max(max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2])), float(m[3]));
                        }
                        mask_cache[idx / WorkGroupSize] = m;
                    }
                } else
                [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t c = (idx + tid) / (Br / 4);
                    uint32_t r = (idx + tid) % (Br / 4);
                    if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                        uint32_t kcol;
                        bool kv_active = fa_kv_index(j * Bc + c, kcol);
                        if (kv_active) {
                            f16vec4 m;
                            if (USE_SPARSE) {
                                // sparse is gqa-gated (m_stride == 0): all four rows share the value
                                FLOAT_TYPE mv = FLOAT_TYPE(data_m[m_offset + kcol]);
                                m = f16vec4(mv);
                                max_mask = max(max_mask, float(mv));
                            } else if (p.gqa_ratio > 1) {
                                // rows map to (token, head); mask is per token: m_offset already holds gqa_iq1 * KV
                                m = f16vec4(0.0);
                                [[unroll]] for (uint32_t k = 0; k < 4; ++k) {
                                    const uint32_t row = r * 4 + k;
                                    if (row < N && gqa_row_token(row) < p.nem1) {
                                        m[k] = data_m[m_offset + gqa_row_mrow(row) * KV + (j * Bc + c)];
                                        max_mask = max(max_mask, float(m[k]));
                                    }
                                }
                            } else if (!nem1_bounds_check || i * Br + r * 4 + 3 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 2) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 3) * m_stride + (j * Bc + c)]);
                                max_mask = max(max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2])), float(m[3]));
                            } else if (i * Br + r * 4 + 2 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 2) * m_stride + (j * Bc + c)],
                                            0.0);
                                max_mask = max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2]));
                            } else if (i * Br + r * 4 + 1 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            0.0,
                                            0.0);
                                max_mask = max(max(max_mask, float(m[0])), float(m[1]));
                            } else if (i * Br + r * 4 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            0.0,
                                            0.0,
                                            0.0);
                                max_mask = max(max_mask, float(m[0]));
                            } else {
                                m = f16vec4(0.0);
                            }
                            mask_cache[idx / WorkGroupSize] = m;
                        } else if (USE_SPARSE) {
                            mask_cache[idx / WorkGroupSize] = f16vec4(NEG_FLT_MAX_OVER_2);
                        }
                    }
                }
                // skip the block if the mask is entirely -inf
                bool all_less = subgroupAll(max_mask <= NEG_FLT_MAX_OVER_2);
                barrier();
                if (gl_SubgroupInvocationID == 0) {
                    tmpsh[gl_SubgroupID] = all_less ? NEG_FLT_MAX_OVER_2 : 0.0f;
                }
                barrier();
                [[unroll]] for (uint s = 0; s < gl_NumSubgroups; ++s) {
                    max_mask = max(max_mask, tmpsh[s]);
                }
                if (max_mask <= NEG_FLT_MAX_OVER_2) {
                    continue;
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSK_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSK_pad / 4);
                uint32_t c = (idx + tid) / (HSK_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSK_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                    uint32_t kcol;
                    bool kv_active = fa_kv_index(j * Bc + c, kcol);
                    if (kv_active && (HSK == HSK_pad || d < HSK / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_K) {
                            uint coord = kcol * k_stride * BLOCK_SIZE_K + 4 * d;
                            uint ib = coord / BLOCK_SIZE_K;
                            uint iqs = (coord % BLOCK_SIZE_K);
                            K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                        } else
#endif
                        {
                            K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + kcol * k_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = K_Tf;
                }
            }
            barrier();
        }

        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, 16, gl_MatrixUseA> KMat;
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBr, gl_MatrixUseB> QMat;

        if (PV_REG) {
            // step B: S = Q * K^T. Q as A RowMajor from Qf, K^T as B ColumnMajor straight from global (same
            // addresses as the old K A-RowMajor load): both per-lane contiguous, 2 b128 each, as before. This
            // subgroup owns kv columns [16 s, 16 s + 16) of S, stored row-major into sfsh2.
            // TILE_LOOP: SfB1 / SfB2 = S of tiles 1 / 2, against the same K B-operand (the shared dequant)
            PV_ACC(ACC_TYPE) SfB = PV_ACC(ACC_TYPE)(0), SfB1 = PV_ACC(ACC_TYPE)(0), SfB2 = PV_ACC(ACC_TYPE)(0);
            const uint SG_LANES_K = gl_WorkGroupSize.x / row_split;   // == subgroup size for cm1
            const uint kt_base = gl_SubgroupID * PV_REGION;          // this subgroup's step-C region (mode 3)
            if (!ABL_QK)
            [[unroll]] for (uint32_t d = 0; d < HSK_pad / 16; ++d) {
                coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBr, 16, gl_MatrixUseA> QA;
                coopMatLoad(QA, Qf, d * 16 / 4, qstride, gl_CooperativeMatrixLayoutRowMajor);
#if !defined(BFLOAT16)
                if (FaTypeK == GGML_TYPE_Q8_0) {
                    // GGML_VK_FA_PV_REG_QUANT: this subgroup's 16 kv rows x 16 d of K, dequantized into kvsh[kv][d]
                    // (row stride VT4 = 48 B: the ColumnMajor B load is conflict-free as for transposed V). C2: lane
                    // (r, h) = (gidx / 2, gidx % 2) dequantizes 8 contiguous d (dequantize8_q8_0, one scale load),
                    // so a wave32 subgroup covers the 16 x 16 chunk in one pass; C1 was 4 d per lane (dequantize4).
                    // One barrier before (WAR vs the previous chunk's KB load), one after (RAW), as in step C.
                    subgroupBarrier();
                    [[unroll]] for (uint32_t g = 0; g < CEIL_DIV(MatBc * 2, SG_LANES_K); ++g) {
                        const uint gidx = g * SG_LANES_K + gl_SubgroupInvocationID;
                        if (gidx < MatBc * 2) {
                            const uint r = gidx / 2;
                            const uint h = gidx % 2;
                            const uint coord = (j * Bc + gl_SubgroupID * MatBc + r) * k_stride * BLOCK_SIZE_K + d * 16 + h * 8;
                            FLOAT_TYPEV4 klo, khi;
                            dequantize8_q8_0(coord / BLOCK_SIZE_K, coord % BLOCK_SIZE_K, k_offset, BINDING_IDX_K, klo, khi);
                            kvsh[kt_base + r * VT4 + 2 * h]     = klo;
                            kvsh[kt_base + r * VT4 + 2 * h + 1] = khi;
                        }
                    }
                    subgroupMemoryBarrierShared();
                    subgroupBarrier();
                    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBc, gl_MatrixUseB> KBq;
                    coopMatLoad(KBq, kvsh, kt_base, VT4, gl_CooperativeMatrixLayoutColumnMajor);
                    SfB = coopMatMulAdd(QA, KBq, SfB);
                    if (TL > 1) {
                        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBr, 16, gl_MatrixUseA> QA1;
                        coopMatLoad(QA1, Qf, 1 * Br * qstride + d * 16 / 4, qstride, gl_CooperativeMatrixLayoutRowMajor);
                        SfB1 = coopMatMulAdd(QA1, KBq, SfB1);
                    }
                    if (TL > 2) {
                        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBr, 16, gl_MatrixUseA> QA2;
                        coopMatLoad(QA2, Qf, 2 * Br * qstride + d * 16 / 4, qstride, gl_CooperativeMatrixLayoutRowMajor);
                        SfB2 = coopMatMulAdd(QA2, KBq, SfB2);
                    }
                } else
#endif
                {
                    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBc, gl_MatrixUseB> KB;
                    coopMatLoad(KB, data_kv4, k_offset / 4 + (j * Bc + gl_SubgroupID * MatBc) * k_stride / 4 + d * 16 / 4, k_stride / 4, gl_CooperativeMatrixLayoutColumnMajor);
                    SfB = coopMatMulAdd(QA, KB, SfB);
                    if (TL > 1) {
                        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBr, 16, gl_MatrixUseA> QA1;
                        coopMatLoad(QA1, Qf, 1 * Br * qstride + d * 16 / 4, qstride, gl_CooperativeMatrixLayoutRowMajor);
                        SfB1 = coopMatMulAdd(QA1, KB, SfB1);
                    }
                    if (TL > 2) {
                        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBr, 16, gl_MatrixUseA> QA2;
                        coopMatLoad(QA2, Qf, 2 * Br * qstride + d * 16 / 4, qstride, gl_CooperativeMatrixLayoutRowMajor);
                        SfB2 = coopMatMulAdd(QA2, KB, SfB2);
                    }
                }
            }
            if (S_ALIAS) {
                // TILE_LOOP: S of this subgroup's 16 kv columns for every tile into its own kvsh region, f32 bits in
                // f16vec4 elements (8 elements = 16 f32 per row); the subgroup's last KBq load of the region is before
                // this in program order, the barrier is the WAR guard the K staging loop uses too.
                subgroupBarrier();
                coopMatStore(SfB, kvsh, kt_base, MatBc / 2, gl_CooperativeMatrixLayoutRowMajor);
                if (TL > 1) { coopMatStore(SfB1, kvsh, kt_base + 1 * Br * (MatBc / 2), MatBc / 2, gl_CooperativeMatrixLayoutRowMajor); }
                if (TL > 2) { coopMatStore(SfB2, kvsh, kt_base + 2 * Br * (MatBc / 2), MatBc / 2, gl_CooperativeMatrixLayoutRowMajor); }
            } else {
                coopMatStore(SfB, sfsh2, gl_SubgroupID * MatBc / 2, sfsh2_stride, gl_CooperativeMatrixLayoutRowMajor);
            }
            barrier();
        } else {
        // K * Q^T -> S^T: Bc x HSK_pad * HSK_pad x Br -> Bc x Br
        // Bc split across workgroup (four subgroups), loop over HSK in chunks of 16: 16 x 16 * 16 x 16 -> 16 x 16
        // This is written transposed in order to allow for N being 8 if implementations need it
        // One accumulator per 16-row Q block: the K tile is loaded once per d-chunk and reused
        // for every row block, which is what makes Br > 16 cheaper per row than Br == 16.
        coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> SfMat[RowBlocks];
        [[unroll]] for (uint32_t rb = 0; rb < RowBlocks; ++rb) {
            SfMat[rb] = coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
        }
        if (!ABL_QK)
        [[unroll]] for (uint32_t d = 0; d < HSK_pad / 16; ++d) {
            // If SHMEM_STAGING is set, a Bc * HSK_pad size tile of K is loaded to shmem
            // If not, K is loaded directly from global memory if aligned, otherwise
            // staged through a Bc * MatBr size staging buffer.
            // If K is a quant type, then it is always staged for dequantization.
            if (SHMEM_STAGING == 0) {
            // For quants we always need to dequant into kvsh; for f16/bf16 we can load
            // directly from global memory when alignment / bounds allow it.
            const bool stage_k = USE_DECODE_K || KV_bounds_check || USE_SPARSE || d * 16 + 16 > HSK;
            if (stage_k) {
                barrier();
                [[unroll]] for (uint32_t idx = 0; idx < Bc * MatBr / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t col_vec = (idx + tid) % (MatBr / 4);
                    uint32_t row = (idx + tid) / (MatBr / 4);
                    if (idx + tid < Bc * MatBr / 4) {
                        FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                        uint32_t kcol;
                        bool kv_active = fa_kv_index(j * Bc + row, kcol);
                        if (kv_active && (HSK == HSK_pad || d * 16 + col_vec * 4 < HSK)) {
#if !defined(BFLOAT16)
                            if (USE_DECODE_K) {
                                uint coord = kcol * k_stride * BLOCK_SIZE_K + d * 16 + col_vec * 4;
                                uint ib = coord / BLOCK_SIZE_K;
                                uint iqs = (coord % BLOCK_SIZE_K);
                                K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                            } else
#endif
                            {
                                K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + kcol * k_stride / 4 + d * 16 / 4 + col_vec]);
                            }
                        }

                        kvsh[row * kvsh_stride + col_vec] = K_Tf;
                    }
                }
                barrier();
            }

            if (stage_k) {
                uint coord = (gl_SubgroupID * MatBc) * kvsh_stride;
                coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                const uint coord = k_offset / 4 + (j * Bc + gl_SubgroupID * MatBc) * k_stride / 4 + d * 16 / 4;
                coopMatLoad(KMat, data_kv4, coord, k_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
            }
            } else {
                uint coord = (gl_SubgroupID * MatBc) * kvsh_stride + d * 16 / 4;
                coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
            }

            [[unroll]] for (uint32_t rb = 0; rb < RowBlocks; ++rb) {
                coopMatLoad(QMat, Qf, rb * MatBr * qstride + d * 16 / 4, qstride, gl_CooperativeMatrixLayoutColumnMajor);
                SfMat[rb] = coopMatMulAdd(KMat, QMat, SfMat[rb]);
            }
        }

        [[unroll]] for (uint32_t rb = 0; rb < RowBlocks; ++rb) {
            // sfsh is [Bc cols][Br/4 vec4]: this subgroup's 16 KV columns, row block rb
            uint coord = gl_SubgroupID * MatBc * sfshstride + rb * MatBr / 4;
            coopMatStore(SfMat[rb], sfsh, coord, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        } // !PV_REG

        if (LOGIT_SOFTCAP) {
            if (PV_REG) {
                [[unroll]] for (uint32_t idx = 0; idx < TL * Br * Bc / 2; idx += gl_WorkGroupSize.x) {
                    if (idx + tid < TL * Br * Bc / 2) {
                        const uint32_t e = s_idx((idx + tid) / (Bc / 2), (idx + tid) % (Bc / 2));
                        s_st(e, ACC_TYPEV2(p.logit_softcap * tanh(s_ld(e))));
                    }
                }
            } else
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    sfsh[c * sfshstride + r] = ACC_TYPEV4(p.logit_softcap * tanh(sfsh[c * sfshstride + r]));
                }
            }
            barrier();
        }

        if (MASK_ENABLE && !ABL_MASK && mask_opt_bits != MASK_OPT_ALL_ZERO) {
            if (PV_REG) {
                // same (row, 4-column) ownership as the PV_REG mask loader above (TL tiles, rows contiguous)
                [[unroll]] for (uint32_t idx = 0; idx < Bc * Br * TL / 4; idx += gl_WorkGroupSize.x) {
                    const uint32_t row = (idx + tid) / (Bc / 4);
                    const uint32_t cq  = (idx + tid) % (Bc / 4);
                    const ACC_TYPEV4 mv = ACC_TYPEV4(mask_cache[idx / WorkGroupSize]) * slope[row];
                    const uint32_t e0 = s_idx(row, cq * 2);
                    const uint32_t e1 = s_idx(row, cq * 2 + 1);
                    s_st(e0, s_ld(e0) + mv.xy);
                    s_st(e1, s_ld(e1) + mv.zw);
                }
            } else
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    if (!KV_bounds_check || j * Bc + c < KV) {
                        // Mask nem1 bounds check is handled when loading masks
                        ACC_TYPEV4 masks = ACC_TYPEV4(mask_cache[idx / WorkGroupSize]);
                        ACC_TYPEV4 slopes = ACC_TYPEV4(slope[r * 4], slope[r * 4 + 1], slope[r * 4 + 2], slope[r * 4 + 3]);
                        sfsh[c * sfshstride + r] += slopes * masks;
                    }
                }
            }
            barrier();
        }

        // TILE_LOOP: index tr = qt * rows_per_thread + r, S/P/eM row qt * Br + tile_row(r); TL == 1 off PV_C
        float eMf[rows_per_thread * TL];
        [[unroll]] for (uint32_t qt = 0; qt < TL; ++qt)
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint tr = qt * rows_per_thread + r;
            const uint r_vec  = tile_row(r) / 4;
            const uint r_comp = tile_row(r) % 4;

            float rowmaxf = NEG_FLT_MAX_OVER_2;
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                if (KV_bounds_check && j * Bc + c * cols_per_iter + col_tid >= KV) {
                    continue;
                }
                if (PV_REG) {
                    // step B: this lane owns kv columns col_tid * cols_per_thread + c (adjacent pairs at wave32)
                    const uint col = col_tid * cols_per_thread + c;
                    rowmaxf = max(rowmaxf, float(s_ld(s_idx(qt * Br + tile_row(r), col / 2))[col % 2]));
                } else {
                    rowmaxf = max(rowmaxf, float(sfsh[r_vec + (c * cols_per_iter + col_tid) * sfshstride][r_comp]));
                }
            }
            rowmaxf += FATTN_KQ_MAX_OFFSET;
            float Moldf = Mf[tr];

            // Compute max across the row
            rowmaxf = subgroupMax(rowmaxf);

            // M = max(rowmax, Mold)
            // P = e^(S - M)
            // eM = e^(Mold - M)
            Mf[tr] = max(rowmaxf, Moldf);
            eMf[tr] = exp(Moldf - Mf[tr]);

            Lf[tr] = eMf[tr]*Lf[tr];
            if (ABL_SOFTMAX) {
                eMf[tr] = 1.0f;
                Mf[tr] = 0.0f;
            }
        }

        if (PV_REG) {
            // emsh row tile_row(r) = eM replicated over 16 columns (4 vec4). The row group is the subgroup
            // (threads_per_rowgroup == subgroup size for cm1), so eMf[r] is uniform and lanes 0..3 write it.
            if (col_tid < 4) {
                [[unroll]] for (uint32_t qt = 0; qt < TL; ++qt)
                [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                    emsh[(qt * Br + tile_row(r)) * 4 + col_tid] = ACC_TYPEV4(eMf[qt * rows_per_thread + r]);
                }
            }
        } else {
            [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                const uint d_local = d0 / threads_per_rowgroup;
                [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                    Of[r][d_local] = O_TYPE(eMf[r]) * Of[r][d_local];
                }
            }
        }

        // Calculate and store Pf in Psh
        if (PV_REG) {
            // step B: P row-major into Psh2, same column ownership as the row max above
            [[unroll]] for (uint32_t qt = 0; qt < TL; ++qt)
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint tr = qt * rows_per_thread + r;
                const uint row = qt * Br + tile_row(r);
                [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                    const uint col = col_tid * cols_per_thread + c;
                    const float sv = float(s_ld(s_idx(row, col / 2))[col % 2]);
                    const FLOAT_TYPE Pf = ABL_SOFTMAX ? FLOAT_TYPE(sv) : FLOAT_TYPE(exp(sv - Mf[tr]));
                    Lf[tr] += float(Pf);
                    Psh2[row * psh2_stride + col / 2][col % 2] = Pf;
                }
            }
        } else
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            const uint col = c * cols_per_iter + col_tid;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; r += 4) {
                const uint row = tile_row(r);
                if (KV_bounds_check && j * Bc + col >= KV) {
                    Psh[col * psh_stride + row / 4] = FLOAT_TYPEV4(0.0f);
                } else {
                    const vec4 mfvec = vec4(Mf[r], Mf[r + 1], Mf[r + 2], Mf[r + 3]);
                    const FLOAT_TYPEV4 Pf = ABL_SOFTMAX ? FLOAT_TYPEV4(vec4(sfsh[row / 4 + col * sfshstride]))
                                                      : FLOAT_TYPEV4(exp(vec4(sfsh[row / 4 + col * sfshstride]) - mfvec));
                    [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                        Lf[r + vec_idx] += Pf[vec_idx];
                    }
                    Psh[col * psh_stride + row / 4] = Pf;
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSV_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSV_pad / 4);
                uint32_t c = (idx + tid) / (HSV_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSV_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 V_Tf = FLOAT_TYPEV4(0);
                    uint32_t v_row;
                    bool kv_active = fa_kv_index(j * Bc + c, v_row);
                    if (kv_active && (HSV == HSV_pad || d < HSV / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_V) {
                            uint coord = v_row * v_stride * BLOCK_SIZE_V + 4 * d;
                            uint ib = coord / BLOCK_SIZE_V;
                            uint iqs = (coord % BLOCK_SIZE_V);
                            V_Tf = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                        } else
#endif
                        {
                            V_Tf = FLOAT_TYPEV4(data_vv4[v_offset / 4 + v_row * v_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = V_Tf;
                }
            }
        }
        barrier();

        const uint num_hsv_tiles = (HSV + MatBc * row_split - 1) / (MatBc * row_split); // round up

        if (PV_REG && !ABL_PV) {
            // O = diag(eM) * O: EM element (r, c) = eM[r] from emsh (RowMajor, 4 vec4 per row).
            {
                PV_ACC(ACC_TYPE) EM;
                coopMatLoad(EM, emsh, 0, 16 / 4, gl_CooperativeMatrixLayoutRowMajor);
                if (PV_F32) {
                    PvA0 = PvA0 * EM;
                    if (PV_TILES > 1) { PvA1 = PvA1 * EM; }
                    if (PV_TILES > 2) { PvA2 = PvA2 * EM; }
                    if (PV_TILES > 3) { PvA3 = PvA3 * EM; }
                } else {
                    PV_ACC(O_TYPE) EMh = PV_ACC(O_TYPE)(EM);
                    PvH0 = PvH0 * EMh;
                    if (PV_TILES > 1) { PvH1 = PvH1 * EMh; }
                    if (PV_TILES > 2) { PvH2 = PvH2 * EMh; }
                    if (PV_TILES > 3) { PvH3 = PvH3 * EMh; }
                }
            }
            if (TL > 1) {
                PV_ACC(ACC_TYPE) EM1;
                coopMatLoad(EM1, emsh, 1 * 16 * 16 / 4, 16 / 4, gl_CooperativeMatrixLayoutRowMajor);
                PvB0 = PvB0 * EM1;
                if (PV_TILES > 1) { PvB1 = PvB1 * EM1; }
                if (PV_TILES > 2) { PvB2 = PvB2 * EM1; }
                if (PV_TILES > 3) { PvB3 = PvB3 * EM1; }
            }
            if (TL > 2) {
                PV_ACC(ACC_TYPE) EM2;
                coopMatLoad(EM2, emsh, 2 * 16 * 16 / 4, 16 / 4, gl_CooperativeMatrixLayoutRowMajor);
                PvC0 = PvC0 * EM2;
                if (PV_TILES > 1) { PvC1 = PvC1 * EM2; }
                if (PV_TILES > 2) { PvC2 = PvC2 * EM2; }
                if (PV_TILES > 3) { PvC3 = PvC3 * EM2; }
            }
            // One P load per 16-column KV chunk (was one per chunk per 16-wide d slice: 16 -> 4 per block),
            // then PV_TILES V loads + MMAs into this subgroup's own accumulators. No pvsh store, no barrier.
            // Bit 512 on this path swaps only the global V load (P is already contiguous after step B); in mode 3
            // V comes from the transposed kvsh and bit 512 is a no-op.
            const uint SG_LANES = gl_WorkGroupSize.x / row_split;   // == subgroup size for cm1
            const uint vt_base = gl_SubgroupID * PV_REGION;        // this subgroup's transposed-V region (mode 3)
            [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
                coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, 16, gl_MatrixUseA> PMat;
                coopMatLoad(PMat, Psh2, bc_chunk * MatBc / 2, psh2_stride, gl_CooperativeMatrixLayoutRowMajor);
                // TILE_LOOP: P of tiles 1 / 2 for the same 16 kv; each V B-operand below feeds TL MMAs
                coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, 16, gl_MatrixUseA> PMat1, PMat2;
                if (TL > 1) { coopMatLoad(PMat1, Psh2, 1 * Br * psh2_stride + bc_chunk * MatBc / 2, psh2_stride, gl_CooperativeMatrixLayoutRowMajor); }
                if (TL > 2) { coopMatLoad(PMat2, Psh2, 2 * Br * psh2_stride + bc_chunk * MatBc / 2, psh2_stride, gl_CooperativeMatrixLayoutRowMajor); }
                const uint v_base = v_offset / 4 + (j * Bc + bc_chunk * MatBc) * v_stride / 4 + gl_SubgroupID * (PV_SLICE / 4);
                // TILE_LOOP V phases (PV_VPH > 1): the staged values are loaded once below and kept in registers, each
                // phase stores the lanes of its 32-d half and feeds PV_TPH V tiles (16 VGPR at wave32 either type)
                FLOAT_TYPEV4 vq8[8];
                FLOAT_TYPEV4 vf16[CEIL_DIV(PV_SLICE, SG_LANES)][4];
                if (PV_C) {
                    // step C: lane owns (kv quad q, d vec4 dv): 4 global f16vec4 loads (rows 4q..4q+3) -> 4
                    // f16vec4 stores of 4 kv values each into kvsh[d][kv]. Subgroup-private region, so only
                    // subgroup barriers: one before (WAR vs the previous chunk's loads), one after (RAW).
                    subgroupBarrier();
#if !defined(BFLOAT16)
                    if (FaTypeV == GGML_TYPE_Q8_0) {
                        // GGML_VK_FA_PV_REG_QUANT C2: lane owns (kv quad q, 8-d group d8): 4 rows x 8 contiguous d
                        // via dequantize8_q8_0 (one scale load per row; C1 used 4 dequantize4 per 4 d), then 8
                        // transposed f16vec4 stores [d][kv quad]. v_offset / v_stride are in blocks, so the element
                        // coordinate is rebuilt as row * v_stride * BLOCK_SIZE_V + d (v_base is f16vec4 units, f16 only).
                        // 8 d never straddle a 32-block (d = s * PV_SLICE + 8 * d8, PV_SLICE % 16 == 0).
                        // Measured 2026-10-24 (XTX, 131k, GGML_VK_FA_ABLATE=256 P.V-only): per extra tile 222 -> 210 us
                        // vs C1, while the K side (same loader) gained 21%.
                        // C2b bank rotation (2026-10-24). Store e of lane (q, d8) is kvsh dword 96 d8 + 12 row + 2 q
                        // (f16vec4 = 2 dwords, VT4 = 6 = 12 dwords per d row). 96 d8 = 0 mod 32, so in the C2 mapping
                        // all d8 of an instruction share one 8-dword bank window: 4-way, 64 bank-cycles per chunk on
                        // 32 banks x 4 B (16 lanes per b64 cycle), vs 32 for the f16 loop (48 dv = 0/16 mod 32, 2-way)
                        // and 16 ideal. Padding cannot fix it: the B load needs a 16 B row stride (4k dwords) and
                        // 8 rows x 4k = 0 mod 32 for every k. Fix: lane rotates its 4 int16 word loads by rot = d8 & 3
                        // (dequantize8_q8_0_rot), so register element e is d = (e + 2 rot) & 7 and store e goes to
                        // row 8 d8 + d; 12 d mod 32 for d = e, e+2, e+4, e+6 is {0, 24, 16, 8} (or {12, 4, 28, 20}):
                        // conflict-free on 32 banks (16 cycles/chunk), 2-way like f16 on a 64-bank view. Address
                        // arithmetic only, no selects; layout and the coopMatLoad side are unchanged.
                        // Measured (same binary, GGML_VK_FA_ABLATE=512 restores the C2 mapping): P.V-only per extra
                        // tile 208.8 -> 198.8 us (-4.8%); full kernel 0.976-0.983x at 4-16 tokens (131k, 229k, 32k),
                        // 1.00x at 1-2 tokens. The 20% bar was missed: a probe with the V global loads + dequant
                        // replaced by constants (stores kept, mask skipped) left 136 us/tile rotated, 156 C2-mapped;
                        // with dequant 197 / 207.5. So the stores conflict as modeled (20 us/tile bare, 10 hidden
                        // under the loads), the dequant is ~61 us/tile, and ~136 us/tile is the P.V machinery itself
                        // (P load, V coopMatLoad, MMA, subgroup barriers), the same ~134 us f16 pays from 3 tiles on.
                        const uint vstep = v_stride * BLOCK_SIZE_V;
                        const bool V_ROT = !ABL_PV_LAYOUT;   // GGML_VK_FA_ABLATE=512 restores the C2 store mapping (A/B)
                        [[unroll]] for (uint32_t g = 0; g < CEIL_DIV(PV_SLICE / 2, SG_LANES); ++g) {
                            const uint gidx = g * SG_LANES + gl_SubgroupInvocationID;
                            if (gidx < PV_SLICE / 2) {   // 4 quads x PV_SLICE/8 groups
                                const uint q  = gidx % 4;
                                const uint d8 = gidx / 4;
                                const uint c0 = (j * Bc + bc_chunk * MatBc + 4 * q) * vstep + gl_SubgroupID * PV_SLICE + 8 * d8;
                                const uint rot = V_ROT ? (d8 & 3) : 0;
                                FLOAT_TYPEV4 l0, h0, l1, h1, l2, h2, l3, h3;
                                dequantize8_q8_0_rot(c0 / BLOCK_SIZE_V, c0 % BLOCK_SIZE_V, v_offset, BINDING_IDX_V, rot, l0, h0);
                                dequantize8_q8_0_rot((c0 + vstep) / BLOCK_SIZE_V, (c0 + vstep) % BLOCK_SIZE_V, v_offset, BINDING_IDX_V, rot, l1, h1);
                                dequantize8_q8_0_rot((c0 + 2 * vstep) / BLOCK_SIZE_V, (c0 + 2 * vstep) % BLOCK_SIZE_V, v_offset, BINDING_IDX_V, rot, l2, h2);
                                dequantize8_q8_0_rot((c0 + 3 * vstep) / BLOCK_SIZE_V, (c0 + 3 * vstep) % BLOCK_SIZE_V, v_offset, BINDING_IDX_V, rot, l3, h3);
                                if (PV_VPH == 1) {
                                [[unroll]] for (uint32_t c = 0; c < 4; ++c) {
                                    kvsh[vt_base + (d8 * 8 + ((c + 2 * rot) & 7)) * VT4 + q]     = FLOAT_TYPEV4(l0[c], l1[c], l2[c], l3[c]);
                                    kvsh[vt_base + (d8 * 8 + ((c + 4 + 2 * rot) & 7)) * VT4 + q] = FLOAT_TYPEV4(h0[c], h1[c], h2[c], h3[c]);
                                }
                                } else {
                                    vq8[0] = l0; vq8[1] = h0; vq8[2] = l1; vq8[3] = h1;
                                    vq8[4] = l2; vq8[5] = h2; vq8[6] = l3; vq8[7] = h3;
                                }
                            }
                        }
                    } else
#endif
                    [[unroll]] for (uint32_t g = 0; g < CEIL_DIV(PV_SLICE, SG_LANES); ++g) {
                        const uint gidx = g * SG_LANES + gl_SubgroupInvocationID;
                        if (gidx < PV_SLICE) {   // 4 quads x PV_SLICE/4 vec4
                            const uint q  = gidx % 4;
                            const uint dv = gidx / 4;
                            const uint src = v_base + q * v_stride + dv;   // row 4q: 4q * v_stride / 4 vec4
                            const FLOAT_TYPEV4 a0 = data_vv4[src];
                            const FLOAT_TYPEV4 a1 = data_vv4[src + v_stride / 4];
                            const FLOAT_TYPEV4 a2 = data_vv4[src + 2 * (v_stride / 4)];
                            const FLOAT_TYPEV4 a3 = data_vv4[src + 3 * (v_stride / 4)];
                            if (PV_VPH == 1) {
                            [[unroll]] for (uint32_t c = 0; c < 4; ++c) {
                                kvsh[vt_base + (dv * 4 + c) * VT4 + q] = FLOAT_TYPEV4(a0[c], a1[c], a2[c], a3[c]);
                            }
                            } else {
                                vf16[g][0] = a0; vf16[g][1] = a1; vf16[g][2] = a2; vf16[g][3] = a3;
                            }
                        }
                    }
                    subgroupMemoryBarrierShared();
                    subgroupBarrier();
                }
                [[unroll]] for (uint32_t t = 0; t < PV_TILES; ++t) {
                    if (PV_C && PV_VPH > 1 && (t % PV_TPH) == 0) {
                        // TILE_LOOP phase ph: the lanes whose d group falls in half ph store it (same mappings and C2b
                        // rotation as above, rows relative to the half), then PV_TPH V tiles are loaded from the region
                        const uint ph = t / PV_TPH;
                        if (ph > 0) {
                            subgroupBarrier();   // WAR vs the previous phase's VMat loads
                        }
#if !defined(BFLOAT16)
                        if (FaTypeV == GGML_TYPE_Q8_0) {
                            // one lane group: PV_SLICE / 2 <= 32 <= SG_LANES (HSV <= 256)
                            const uint gidx = gl_SubgroupInvocationID;
                            const uint D8PH = PV_SLICE / 8 / PV_VPH;
                            if (gidx < PV_SLICE / 2 && (gidx / 4) / D8PH == ph) {
                                const uint q   = gidx % 4;
                                const uint d8l = (gidx / 4) % D8PH;
                                const uint rot = !ABL_PV_LAYOUT ? (d8l & 3) : 0;   // == (d8 & 3): D8PH % 4 == 0
                                [[unroll]] for (uint32_t c = 0; c < 4; ++c) {
                                    kvsh[vt_base + (d8l * 8 + ((c + 2 * rot) & 7)) * VT4 + q]     = FLOAT_TYPEV4(vq8[0][c], vq8[2][c], vq8[4][c], vq8[6][c]);
                                    kvsh[vt_base + (d8l * 8 + ((c + 4 + 2 * rot) & 7)) * VT4 + q] = FLOAT_TYPEV4(vq8[1][c], vq8[3][c], vq8[5][c], vq8[7][c]);
                                }
                            }
                        } else
#endif
                        [[unroll]] for (uint32_t g = 0; g < CEIL_DIV(PV_SLICE, SG_LANES); ++g) {
                            const uint gidx = g * SG_LANES + gl_SubgroupInvocationID;
                            const uint DVPH = PV_SLICE / 4 / PV_VPH;
                            if (gidx < PV_SLICE && (gidx / 4) / DVPH == ph) {
                                const uint q  = gidx % 4;
                                const uint dl = (gidx / 4) % DVPH;
                                [[unroll]] for (uint32_t c = 0; c < 4; ++c) {
                                    kvsh[vt_base + (dl * 4 + c) * VT4 + q] = FLOAT_TYPEV4(vf16[g][0][c], vf16[g][1][c], vf16[g][2][c], vf16[g][3][c]);
                                }
                            }
                        }
                        subgroupMemoryBarrierShared();
                        subgroupBarrier();
                    }
                    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBr, gl_MatrixUseB> VMat;
                    if (PV_C) {
                        coopMatLoad(VMat, kvsh, vt_base + (t % PV_TPH) * 16 * VT4, VT4, gl_CooperativeMatrixLayoutColumnMajor);
                    } else if (ABL_PV_LAYOUT) {
                        coopMatLoad(VMat, data_vv4, v_base + t * (MatBc / 4), v_stride / 4, gl_CooperativeMatrixLayoutColumnMajor);
                    } else {
                        coopMatLoad(VMat, data_vv4, v_base + t * (MatBc / 4), v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
                    }
                    if (PV_F32) {   // f16 x f16 -> ACC_TYPE, the same MMA kind Q.K uses
                        if (t == 0) { PvA0 = coopMatMulAdd(PMat, VMat, PvA0); }
                        if (t == 1) { PvA1 = coopMatMulAdd(PMat, VMat, PvA1); }
                        if (t == 2) { PvA2 = coopMatMulAdd(PMat, VMat, PvA2); }
                        if (t == 3) { PvA3 = coopMatMulAdd(PMat, VMat, PvA3); }
                        if (TL > 1) {
                            if (t == 0) { PvB0 = coopMatMulAdd(PMat1, VMat, PvB0); }
                            if (t == 1) { PvB1 = coopMatMulAdd(PMat1, VMat, PvB1); }
                            if (t == 2) { PvB2 = coopMatMulAdd(PMat1, VMat, PvB2); }
                            if (t == 3) { PvB3 = coopMatMulAdd(PMat1, VMat, PvB3); }
                        }
                        if (TL > 2) {
                            if (t == 0) { PvC0 = coopMatMulAdd(PMat2, VMat, PvC0); }
                            if (t == 1) { PvC1 = coopMatMulAdd(PMat2, VMat, PvC1); }
                            if (t == 2) { PvC2 = coopMatMulAdd(PMat2, VMat, PvC2); }
                            if (t == 3) { PvC3 = coopMatMulAdd(PMat2, VMat, PvC3); }
                        }
                    } else {
                        if (t == 0) { PvH0 = coopMatMulAdd(PMat, VMat, PvH0); }
                        if (t == 1) { PvH1 = coopMatMulAdd(PMat, VMat, PvH1); }
                        if (t == 2) { PvH2 = coopMatMulAdd(PMat, VMat, PvH2); }
                        if (t == 3) { PvH3 = coopMatMulAdd(PMat, VMat, PvH3); }
                    }
                }
            }
        }

        // Each subgroup handles HSV/4 columns
        if (!PV_REG && !ABL_PV)
        [[unroll]] for (uint32_t hsv_tile = 0; hsv_tile < num_hsv_tiles; ++hsv_tile) {
            const uint hsv_offset = (hsv_tile * row_split + gl_SubgroupID) * 16;

            coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> PVMat[RowBlocks];
            [[unroll]] for (uint32_t rb = 0; rb < RowBlocks; ++rb) {
                PVMat[rb] = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
            }

            // Preload V tiles for [Bc, 16 * num subgroups]
            const uint v_rows = Bc;
            const uint v_total = v_rows * v_cols;
            const uint v_loads_per_thread = v_total / gl_WorkGroupSize.x;

            // If SHMEM_STAGING is set, a Bc * HSV_pad size tile of V is loaded to shmem.
            // If not, V is loaded directly from global memory if aligned, otherwise
            // staged through a Bc * MatBr size staging buffer.
            // If V is a quant type, then it is always staged for dequantization.
            if (SHMEM_STAGING == 0) {
            // For quants we always preload via kvsh. For f16/bf16 we only preload when
            // alignment / bounds force it (otherwise we coopMatLoad direct from data_vv4).
            const bool stage_v = USE_DECODE_V || KV_bounds_check || USE_SPARSE;
            if (stage_v) {
                [[unroll]] for (uint32_t i = 0; i < v_loads_per_thread; ++i) {
                    const uint idx = i * gl_WorkGroupSize.x + tid;
                    const uint row = idx / v_cols;
                    const uint col = idx % v_cols;

                    uint32_t v_row;
                    bool kv_active = fa_kv_index(j * Bc + row, v_row);
                    const uint v_col = hsv_tile * MatBc * row_split + col * 4;

                    const uint coord = v_row * v_stride * BLOCK_SIZE_V + v_col;
                    const uint ib = coord / BLOCK_SIZE_V;
                    const uint iqs = coord % BLOCK_SIZE_V;

                    if (USE_SPARSE ? (kv_active && v_col < HSV) : (!KV_bounds_check || (v_row < KV && v_col < HSV))) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_V) {
                            kvsh[row * vsh_stride + col] = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                        } else
#endif
                        {
                            kvsh[row * vsh_stride + col] = data_vv4[(v_offset + v_row * v_stride + v_col) / 4];
                        }
                    } else {
                        kvsh[row * vsh_stride + col] = FLOAT_TYPEV4(0.0f);
                    }
                }
            }
            }
            barrier();

            const uint o_offset = gl_SubgroupID * MatBr / 4;

            if (hsv_offset < HSV_pad) {
                [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
                    if (SHMEM_STAGING == 0) {
                    if (!USE_DECODE_V && !KV_bounds_check && !USE_SPARSE) {
                        // F16/BF16 values can be loaded directly from global memory
                        const uint v_tile_row = j * Bc + bc_chunk * MatBc;
                        const uint v_tile_offset = v_offset / 4 + v_tile_row * v_stride / 4 + hsv_offset / 4;
                        if (ABL_PV_LAYOUT) {
                            // same 16 rows x 32 B, per-lane contiguous (wrong result, timing only)
                            coopMatLoad(QMat, data_vv4, v_tile_offset, v_stride / 4, gl_CooperativeMatrixLayoutColumnMajor);
                        } else {
                            coopMatLoad(QMat, data_vv4, v_tile_offset, v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
                        }
                    } else {
                        const uint v_tile_offset = bc_chunk * MatBr * v_cols + gl_SubgroupID * (MatBc / 4);
                        coopMatLoad(QMat, kvsh, v_tile_offset, vsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                    } else {
                        const uint v_tile_offset = bc_chunk * MatBc * kvsh_stride + (hsv_tile * row_split + gl_SubgroupID) * (MatBc / 4);
                        coopMatLoad(QMat, kvsh, v_tile_offset, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }

                    // V tile loaded once (QMat), P row blocks stream through KMat
                    [[unroll]] for (uint32_t rb = 0; rb < RowBlocks; ++rb) {
                        if (ABL_PV_LAYOUT) {
                            // same 16 x psh_stride region, per-lane contiguous (wrong result, timing only)
                            coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride + rb * MatBr / 4, psh_stride, gl_CooperativeMatrixLayoutRowMajor);
                        } else {
                            coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride + rb * MatBr / 4, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                        }
                        PVMat[rb] = coopMatMulAdd(KMat, QMat, PVMat[rb]);
                    }
                }

                // Store PVMat to pvsh ([Br rows][osh_stride]) and load into Of
                [[unroll]] for (uint32_t rb = 0; rb < RowBlocks; ++rb) {
                    coopMatStore(PVMat[rb], pvsh, rb * MatBr * osh_stride + o_offset, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                }
            }

            barrier();

            const uint hsv_per_tile = row_split * MatBc;
            const uint hsv_base = hsv_tile * hsv_per_tile;
            const uint d_values_per_tile = hsv_per_tile / 4;

            const uint d_start = hsv_tile * d_values_per_tile;
            const uint d_end = min(d_start + d_values_per_tile, HSV / 4);

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);

                [[unroll]] for (uint32_t d_local = 0; d_local < d_per_thread; ++d_local) {
                    const uint d = d_local * threads_per_rowgroup + col_tid;
                    const uint hsv_col = 4 * d;

                    if (hsv_col >= hsv_base && hsv_col < hsv_base + hsv_per_tile && hsv_col < HSV) {
                        const uint local_hsv = (hsv_col - hsv_base) / 4;
                        Of[r][d_local] += pvsh[row * osh_stride + local_hsv];
                    }
                }
            }
        }

        barrier();
    }

    if (PV_REG) {
        // Once per workgroup: accumulators -> Qf (dead after the last Q.K; f16vec4 like O_TYPEV4, Br x qstride >=
        // Br x HSV/4 because the gate requires HSV_pad <= HSK_pad) -> Of in the thread-owns-rows layout, so the
        // split-k store, sinks, 1/L and the gqa output mapping below run unchanged. Mode 1 rounds f32 -> f16 here,
        // once, which is where the old path's Of already lived. TILE_LOOP: tile t's accumulators go to Qf row t * Br
        // and the per-tile loop below rebuilds Of from them.
        barrier();
        const uint o_col = gl_SubgroupID * (PV_SLICE / 4);
        if (PV_F32) {
            coopMatStore(PV_ACC(O_TYPE)(PvA0), Qf, o_col, qstride, gl_CooperativeMatrixLayoutRowMajor);
            if (PV_TILES > 1) { coopMatStore(PV_ACC(O_TYPE)(PvA1), Qf, o_col + 1 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
            if (PV_TILES > 2) { coopMatStore(PV_ACC(O_TYPE)(PvA2), Qf, o_col + 2 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
            if (PV_TILES > 3) { coopMatStore(PV_ACC(O_TYPE)(PvA3), Qf, o_col + 3 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
            if (TL > 1) {
                const uint ob = 1 * Br * qstride + o_col;
                coopMatStore(PV_ACC(O_TYPE)(PvB0), Qf, ob, qstride, gl_CooperativeMatrixLayoutRowMajor);
                if (PV_TILES > 1) { coopMatStore(PV_ACC(O_TYPE)(PvB1), Qf, ob + 1 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
                if (PV_TILES > 2) { coopMatStore(PV_ACC(O_TYPE)(PvB2), Qf, ob + 2 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
                if (PV_TILES > 3) { coopMatStore(PV_ACC(O_TYPE)(PvB3), Qf, ob + 3 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
            }
            if (TL > 2) {
                const uint oc = 2 * Br * qstride + o_col;
                coopMatStore(PV_ACC(O_TYPE)(PvC0), Qf, oc, qstride, gl_CooperativeMatrixLayoutRowMajor);
                if (PV_TILES > 1) { coopMatStore(PV_ACC(O_TYPE)(PvC1), Qf, oc + 1 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
                if (PV_TILES > 2) { coopMatStore(PV_ACC(O_TYPE)(PvC2), Qf, oc + 2 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
                if (PV_TILES > 3) { coopMatStore(PV_ACC(O_TYPE)(PvC3), Qf, oc + 3 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
            }
        } else {
            coopMatStore(PvH0, Qf, o_col, qstride, gl_CooperativeMatrixLayoutRowMajor);
            if (PV_TILES > 1) { coopMatStore(PvH1, Qf, o_col + 1 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
            if (PV_TILES > 2) { coopMatStore(PvH2, Qf, o_col + 2 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
            if (PV_TILES > 3) { coopMatStore(PvH3, Qf, o_col + 3 * (MatBc / 4), qstride, gl_CooperativeMatrixLayoutRowMajor); }
        }
        barrier();
    }

    // TILE_LOOP: the epilogue once per tile (TL == 1 everywhere but PV_C + GQA_DENSE). Row qt * Br + tile_row(r),
    // M / L index qt * rows_per_thread + r. The split_k branch ends with continue (was return), the same at TL 1.
    [[unroll]] for (uint32_t qt = 0; qt < TL; ++qt) {
    if (PV_REG) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            [[unroll]] for (uint32_t d_local = 0; d_local < d_per_thread; ++d_local) {
                const uint d = d_local * threads_per_rowgroup + col_tid;
                if (d < HSV / 4) {
                    Of[r][d_local] = Qf[(qt * Br + tile_row(r)) * qstride + d];
                }
            }
        }
    }

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[qt * rows_per_thread + r] = subgroupAdd(Lf[qt * rows_per_thread + r]);
    }

    // If there is split_k, then the split_k resolve shader does the final
    // division by L. Store the intermediate O value and per-row m and L values.
    if (p.k_num > 1) {
        if (p.gqa_ratio > 1) {
            // note: O and Q have swapped coord 1,2. Partials are laid out [HSV, ne1, k_num, ne2, ne3];
            // each row goes to its own (token, head).
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint32_t row = qt * Br + tile_row(r);
                if (gqa_row_valid(row)) {
                    const uint32_t tok  = gqa_row_token(row);
                    const uint32_t head = gqa_row_head(row);
                    const uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (tok + p.ne2 * iq3)) / 4 + head * HSV / 4;
                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        const uint d_local = d0 / threads_per_rowgroup;
                        data_ov4[o_offset + d] = D_TYPEV4(Of[r][d_local]);
                    }
                    if (col_tid == 0) {
                        const uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (tok + p.ne2 * iq3));
                        data_o[lm_offset + head] = D_TYPE(Lf[qt * rows_per_thread + r]);
                        data_o[lm_offset + p.ne1 + head] = D_TYPE(Mf[qt * rows_per_thread + r]);
                    }
                }
            }
        } else {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = qt * Br + tile_row(r);
                const uint global_row = i * Br + row;

                if (global_row < N) {
                    uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3)) / 4;

                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        data_ov4[o_offset + iq2 * HSV/4 + d] = D_TYPEV4(Of[r][d/threads_per_rowgroup]);
                    }
                }

                if (global_row < N && col_tid == 0) {
                    uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3));
                    data_o[lm_offset + iq2] = D_TYPE(Lf[qt * rows_per_thread + r]);
                    data_o[lm_offset + p.ne1 + iq2] = D_TYPE(Mf[qt * rows_per_thread + r]);
                }
            }
        }

        continue;
    }

    if ((p.mask_n_head_log2 & SINK_ENABLE_BIT) != 0) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint tr = qt * rows_per_thread + r;
            float sink = perElemOpGetSink(gqa_row_hidx(qt * Br + tile_row(r)), 0u, ACC_TYPE(0), iq2);

            float ms = 1.0f;
            float vs = 1.0f;

            if (sink > Mf[tr]) {
                ms = exp(Mf[tr] - sink);

                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d_local = d0 / threads_per_rowgroup;
                    Of[r][d_local] *= O_TYPE(ms);
                }
            } else {
                vs = exp(sink - Mf[tr]);
            }

            Lf[tr] = Lf[tr]*ms + vs;
            // Lf is now relative to max(Mf, sink); only the EMIT_LSE store reads Mf after this point
            Mf[tr] = max(Mf[tr], sink);
        }
    }

    float Lfrcp[rows_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        const float l = Lf[qt * rows_per_thread + r];
        Lfrcp[r] = (l == 0.0) ? 0.0 : (1.0 / l);
    }

    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
        const uint d_local = d0 / threads_per_rowgroup;
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            Of[r][d_local] *= O_TYPE(Lfrcp[r]);
#if defined(FLOAT_TYPE_MAX)
            Of[r][d_local] = clamp(Of[r][d_local], -FLOAT_TYPE_MAX, FLOAT_TYPE_MAX);
#endif
        }
    }

    // final dst rows are HSV_out apart (HSV + 4 with EMIT_LSE, see flash_attn_base.glsl); the split_k partials
    // above keep the HSV stride and flash_attn_split_k_reduce.comp writes the lse in that case
    uint32_t o_offset = (gqa_iq1*p.ne1*HSV_out + iq3*p.ne2*p.ne1*HSV_out) / 4;

    if (p.gqa_ratio > 1) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint32_t row = qt * Br + tile_row(r);
            if (gqa_row_valid(row)) {
                // O is [HSV_out, ne1 = heads, ne2 = tokens, ne3]
                const uint32_t ro = (iq3 * p.ne2 * p.ne1 * HSV_out) / 4 + ((gqa_row_token(row) * p.ne1 + gqa_row_head(row)) * HSV_out) / 4;
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    data_ov4[ro + d] = D_TYPEV4(Of[r][d_local]);
                }
                if (EMIT_LSE && col_tid == 0) {
                    storeLse(ro, Mf[qt * rows_per_thread + r], Lf[qt * rows_per_thread + r]);
                }
            }
        }
    } else {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint row = qt * Br + tile_row(r);
            if (i * Br + row < N) {
                const uint32_t ro = o_offset + (iq2 * HSV_out + (i * Br + row) * p.ne1 * HSV_out) / 4;
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    data_ov4[ro + d] = D_TYPEV4(Of[r][d_local]);
                }
                if (EMIT_LSE && col_tid == 0) {
                    storeLse(ro, Mf[qt * rows_per_thread + r], Lf[qt * rows_per_thread + r]);
                }
            }
        }
    }
    } // TILE_LOOP qt
}
